# Puerto de escucha del servidor
PORT=3000

# URL de conexión a la base de datos PostgreSQL (Neon / Supabase / Render PostgreSQL)
# Ejemplo: postgresql://usuario:contraseña@ep-cool-butterfly-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://usuario:contraseña@host:puerto/nombre_db?sslmode=require"

# Secreto JWT para firmar los tokens de acceso
JWT_ACCESS_SECRET="super-secret-access-key-control-materiales-production"

# (Opcional) Configuración de almacenamiento MinIO / AWS S3 para evidencias
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_ENDPOINT=
