// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  administrador
  supervisor
  trabajador
  cliente
}

enum HitoEstatus {
  pendiente
  completado
  atrasado
}

enum DeclaracionEstado {
  declarado_cliente
  declarado_cotizado
  real_recibido
}

enum AvanceItemTipo {
  planeado
  no_planeado
}

enum AvanceItemSubtipo {
  retrabajo
  extra
  modificacion
}

enum IncidenteEstatus {
  abierto
  resuelto
}

enum EstadoJornada {
  TRABAJANDO
  TIEMPO_MUERTO
  COMIDA
  FINALIZADA
}

model Usuario {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nombre    String
  rol       Rol
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  proyectos MemberProyecto[]
  avances   Avance[]
  auditoriasCelda AvanceCeldaAuditoria[]
  jornadas        JornadaLaboral[]

  @@map("usuarios")
}

model Proyecto {
  id                String    @id @default(uuid())
  nombre            String
  cliente           String
  logoCliente       String?   @map("logo_cliente")
  liderCliente      String?   @map("lider_cliente")
  liderTecnogam     String?   @map("lider_tecnogam")
  telefonoLiderCliente String? @map("telefono_lider_cliente")
  fechaInicio       DateTime  @map("fecha_inicio")
  fechaFinEstimada  DateTime  @map("fecha_fin_estimada")
  fechaCulminacion  DateTime? @map("fecha_culminacion")
  diasAlertaHito    Int?      @default(7) @map("dias_alerta_hito")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  miembros             MemberProyecto[]
  hitos                Hito[]
  materialesCotizados  MaterialCotizado[]
  materialesCapturados MaterialCapturado[]
  materialesExtras     MaterialExtra[]
  declaraciones        DeclaracionMaterial[]
  avances              Avance[]
  incidentes           Incidente[]
  tiemposMuertos       TiempoMuerto[]
  avancesInstrumentacion AvanceInstrumentacion[]
  avancesValvulas        AvanceValvula[]
  avancesMotores         AvanceMotor[]
  jornadas               JornadaLaboral[]

  @@map("proyectos")
}

model MemberProyecto {
  id         String   @id @default(uuid())
  usuarioId  String   @map("usuario_id")
  proyectoId String   @map("proyecto_id")
  createdAt  DateTime @default(now()) @map("created_at")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, proyectoId])
  @@map("miembros_proyecto")
}

model Hito {
  id            String      @id @default(uuid())
  nombre        String
  fechaObjetivo DateTime    @map("fecha_objetivo")
  fechaCompletado DateTime? @map("fecha_completado")
  estatus       HitoEstatus @default(pendiente)
  diasAlerta    Int?        @default(7) @map("dias_alerta")
  proyectoId    String      @map("proyecto_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@map("hitos")
}

model Material {
  id          String   @id @default(uuid())
  codigo      String   @unique
  descripcion String
  unidad      String
  categoria   String
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cotizaciones MaterialCotizado[]
  capturas     MaterialCapturado[]
  declarados   DeclaracionMaterial[]
  avanceItems  AvanceItem[]

  @@map("materiales")
}

model MaterialCotizado {
  id         String   @id @default(uuid())
  proyectoId String   @map("proyecto_id")
  materialId String   @map("material_id")
  cantidad   Float
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@unique([proyectoId, materialId])
  @@map("materiales_cotizados")
}

model MaterialCapturado {
  id             String   @id @default(uuid())
  proyectoId     String   @map("proyecto_id")
  materialId     String?  @map("material_id")
  materialManual String?  @map("material_manual")
  cantidad       Float
  fecha          DateTime
  latitud        Float?
  longitud       Float?
  evidenciaUrl   String?  @map("evidencia_url")
  createdAt      DateTime @default(now()) @map("created_at")

  proyecto Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  material Material? @relation(fields: [materialId], references: [id])

  @@map("materiales_capturados")
}

model MaterialExtra {
  id             String   @id @default(uuid())
  proyectoId     String   @map("proyecto_id")
  materialManual String   @map("material_manual")
  cantidad       Float
  createdAt      DateTime @default(now()) @map("created_at")

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@map("materiales_extras")
}

model DeclaracionMaterial {
  id         String            @id @default(uuid())
  proyectoId String            @map("proyecto_id")
  materialId String            @map("material_id")
  estado     DeclaracionEstado
  cantidad   Float
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@map("declaraciones_materiales")
}

model Avance {
  id           String   @id @default(uuid())
  proyectoId   String   @map("proyecto_id")
  fecha        DateTime
  frente       String
  autorId      String   @map("autor_id")
  latitud      Float?
  longitud     Float?
  evidenciaUrl String?  @map("evidencia_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  proyecto Proyecto     @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  autor    Usuario      @relation(fields: [autorId], references: [id])
  items    AvanceItem[]

  @@map("avances")
}

model AvanceItem {
  id             String             @id @default(uuid())
  avanceId       String             @map("avance_id")
  tipo           AvanceItemTipo
  subtipo        AvanceItemSubtipo?
  materialId     String?            @map("material_id")
  materialManual String?            @map("material_manual")
  cantidad       Float

  avance   Avance    @relation(fields: [avanceId], references: [id], onDelete: Cascade)
  material Material? @relation(fields: [materialId], references: [id])

  @@map("avance_items")
}

model Incidente {
  id           String           @id @default(uuid())
  proyectoId   String           @map("proyecto_id")
  categoria    String
  descripcion  String
  fecha        DateTime
  latitud      Float?
  longitud     Float?
  evidenciaUrl String?          @map("evidencia_url")
  estatus      IncidenteEstatus @default(abierto)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@map("incidentes")
}

model TiempoMuerto {
  id         String   @id @default(uuid())
  proyectoId String   @map("proyecto_id")
  frente     String
  causa      String
  duracion   Float // horas
  fecha      DateTime
  createdAt  DateTime @default(now()) @map("created_at")

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@map("tiempos_muertos")
}

model BitacoraSincronizacion {
  id            String   @id @default(uuid())
  dispositivoId String?  @map("dispositivo_id")
  tipo          String
  fecha         DateTime @default(now())
  estatus       String
  detalles      String?

  @@map("bitacora_sincronizaciones")
}

model AvanceCeldaAuditoria {
  id            String   @id @default(uuid())
  modulo        String   @map("modulo") // 'instrumentacion' | 'valvulas' | 'motor'
  filaId        String   @map("fila_id")
  columna       String   @map("columna")
  valorAnterior String?  @map("valor_anterior")
  valorNuevo    String?  @map("valor_nuevo")
  usuarioId     String   @map("usuario_id")
  createdAt     DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([modulo, filaId, columna])
  @@map("avances_celda_auditoria")
}

model AvanceInstrumentacion {
  id              String   @id @default(uuid())
  proyectoId      String   @map("proyecto_id")

  // Columnas Negras (Admin)
  item            Int
  tipoVariable    String   @map("tipo_variable")
  equipoAsoc      String   @map("equipo_asociado")
  tag             String
  cant            Int      @default(1)
  servicioSuple   String   @map("servicio_suple")
  ubicacion       String
  evk             String

  // Columnas Naranjas (Supervisor)
  instaladoPlanta String?  @default("0") @map("instalado_planta")
  cableado        String?  @default("0")
  cantidadCable   Float?   @default(0)   @map("cantidad_cable")
  peinadoCinchado String?  @default("0") @map("peinado_cinchado")
  conexionPlanta  String?  @default("0") @map("conexion_planta")
  conexionTablero String?  @default("0") @map("conexion_tablero")
  pruebas         String?  @default("0")
  nota            String?

  // Metadatos de auditoría última edición por celda
  celdasAudit     Json?    @map("celdas_audit")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt      @map("updated_at")

  proyecto        Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([proyectoId])
  @@map("avances_instrumentacion")
}

model AvanceValvula {
  id                  String   @id @default(uuid())
  proyectoId          String   @map("proyecto_id")

  // Columnas Negras (Admin)
  item                Int
  tag                 String
  servicioCumple      String   @map("servicio_cumple")
  funcionamiento      String
  tipoValvula         String   @map("tipo_valvula")
  ubicacion           String
  falla               String
  notaAdmin           String?  @map("nota_admin")

  // Columnas Naranjas - Neumática (Supervisor)
  cableadoNeum        String?  @default("0") @map("cableado_neumatico")
  cableNeumInstal     Float?   @default(0)   @map("cable_neumatico_instalado")
  peinadoNeum         String?  @default("0") @map("peinado_neumatico")
  conectorRapido      String?  @default("Pendiente") @map("conector_rapido")
  conexionPlantaNeum  String?  @default("0") @map("conexion_planta_neum")
  conexionManifold    String?  @default("0") @map("conexion_manifold")
  pruebasNeum         String?  @default("0") @map("pruebas_neum")
  notasNeum           String?  @map("notas_neum")

  // Columnas Naranjas - Control (Supervisor)
  cableadoCtrl        String?  @default("0") @map("cableado_control")
  cableCtrlInstal     String?  @default("0") @map("cable_control_instalado")
  peinadoCtrl         String?  @default("0") @map("peinado_control")
  sensorPosicion      String?  @default("Pendiente") @map("sensor_posicion")
  conexionPlantaCtrl  String?  @default("0") @map("conexion_planta_ctrl")
  conexionTableroCtrl String?  @default("0") @map("conexion_tablero_ctrl")
  comisioning         String?  @default("0")
  comisionamiento     String?  @default("0")
  notasCtrl           String?  @map("notas_control")

  // Metadatos de auditoría última edición por celda
  celdasAudit         Json?    @map("celdas_audit")

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt      @map("updated_at")

  proyecto            Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([proyectoId])
  @@map("avances_valvulas")
}

model AvanceMotor {
  id                String   @id @default(uuid())
  proyectoId        String   @map("proyecto_id")

  // Columnas Negras (Admin)
  part              String
  tag               String
  description       String
  operatingMode     String   @map("operating_mode")
  voltage           String
  hp                String
  phases            String
  flaCurrent        String   @map("fla_current")
  fla125Current     String   @map("fla_125_current")
  temperatureFactor String   @map("temperature_factor")
  groupingFactor    String   @map("grouping_factor")
  wiresPerPhase     String   @map("wires_per_phase")
  voltageLossFactor String   @map("voltage_loss_factor")
  cableLengthMts    String   @map("cable_length_mts")
  voltageLossPct    String   @map("voltage_loss_pct")
  wireGauge         String   @map("wire_gauge")
  groundWireGauge   String   @map("ground_wire_gauge")
  ubicacion         String
  tamanoCable       String   @map("tamano_cable")

  // Columnas Naranjas (Supervisor)
  cableado          String?  @default("0")
  cantidadCable     Float?   @default(0)   @map("cantidad_cable")
  peinadoCinchado   String?  @default("0") @map("peinado_cinchado")
  pruebasAislMotor  String?  @default("0") @map("pruebas_aisl_motor")
  pruebasAislCirc   String?  @default("0") @map("pruebas_aisl_circ")
  conexionMotor     String?  @default("0") @map("conexion_motor")
  conexionCcm       String?  @default("0") @map("conexion_ccm")
  motorSoloRun      String?  @default("0") @map("motor_solo_run")
  notas             String?

  // Metadatos de auditoría última edición por celda
  celdasAudit       Json?    @map("celdas_audit")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt      @map("updated_at")

  proyecto          Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([proyectoId])
  @@map("avances_motores")
}

model JornadaLaboral {
  id                 String        @id @default(uuid())
  proyectoId         String        @map("proyecto_id")
  supervisorId       String        @map("supervisor_id")
  fecha              DateTime
  estado             EstadoJornada @default(TRABAJANDO)
  horaInicio         DateTime      @default(now()) @map("hora_inicio")
  horaFin            DateTime?     @map("hora_fin")
  horasTrabajadas    Float         @default(0) @map("horas_trabajadas")
  horasTiempoMuerto  Float         @default(0) @map("horas_tiempo_muerto")
  horasComida        Float         @default(0) @map("horas_comida")
  ultimoCambioEstado DateTime      @default(now()) @map("ultimo_cambio_estado")
  notas              String?
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  proyecto   Proyecto        @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  supervisor Usuario         @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  eventos    JornadaEvento[]

  @@unique([proyectoId, supervisorId, fecha])
  @@index([proyectoId, fecha])
  @@map("jornadas_laborales")
}

model JornadaEvento {
  id         String        @id @default(uuid())
  jornadaId  String        @map("jornada_id")
  tipoEstado EstadoJornada @map("tipo_estado")
  inicio     DateTime      @default(now())
  fin        DateTime?
  duracion   Float?
  motivo     String?

  jornada JornadaLaboral @relation(fields: [jornadaId], references: [id], onDelete: Cascade)

  @@index([jornadaId])
  @@map("jornadas_eventos")
}
